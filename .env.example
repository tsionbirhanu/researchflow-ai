# =============================================================================
#  ResearchFlow AI: environment settings
# =============================================================================
#
#  How to use this file
#  --------------------
#  1. Copy it:       cp .env.example .env        (Windows: copy .env.example .env)
#  2. Fill in the five REQUIRED values below.
#  3. Run:           npm run setup
#
#  Who reads it
#  ------------
#  - `npm run setup` (scripts/setup-n8n.js) uses these values to create the n8n
#    credentials and import the workflows. The keys end up stored inside n8n.
#  - `docker compose` reads TIMEZONE and N8N_PUBLIC_URL when it starts n8n.
#  - The running workflow never reads this file.
#
#  Rules
#  -----
#  - One setting per line: NAME=value, with no spaces around "=" and no quotes.
#  - .env is in .gitignore. Never commit it and never share its contents:
#    it holds your API keys and your Google client secret.
#  - After changing a key, run `npm run setup` again so n8n gets the new value.
#    (Credentials it already created are reused; delete .n8n-setup.json or run
#    `npm run setup -- --fresh` to create them again with new values.)
#
# =============================================================================


# -----------------------------------------------------------------------------
#  n8n  (REQUIRED)
# -----------------------------------------------------------------------------

# Address of your n8n instance. Keep the default for the docker-compose setup.
# Do not add a trailing slash or /api.
N8N_URL=http://localhost:5678

# n8n API key. Lets `npm run setup` create credentials and import workflows,
# and lets the error workflow look up failed runs.
# Where: open n8n → Settings (bottom left) → n8n API → Create an API key.
#        Choose "No expiration" so the error workflow keeps working.
# Looks like: a long token starting with "eyJ"
N8N_API_KEY=


# -----------------------------------------------------------------------------
#  AI model: Google Gemini  (REQUIRED, free)
# -----------------------------------------------------------------------------

# Gemini API key, used for every AI step (planning, scoring, analysis,
# writing, fact-checking and the emails).
# Where: https://aistudio.google.com → Get API key → Create API key.
#        Free tier, no credit card needed.
# Looks like: AIzaSy... (39 characters)
# Models are set in the "02 Validate" node (CONFIG.llm), not here.
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
#  Google OAuth client: Gmail + Google Sheets  (REQUIRED, free)
# -----------------------------------------------------------------------------
#  Lets n8n send emails from your Gmail and write the run log to your Sheet.
#  Where: https://console.cloud.google.com → your project →
#         Google Auth Platform → Clients → Create client → "Web application",
#         with this Authorized redirect URI:
#             http://localhost:5678/rest/oauth2-credential/callback
#  The project needs Gmail API, Google Sheets API and Google Drive API enabled,
#  and your Gmail address added under Audience → Test users.
#  Full walkthrough: docs/setup.md, step 3.

# Looks like: 123456789012-abc...xyz.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Shown only once when you create the client. If you lost it, open the client
# and click "+ Add secret". Keep it private.
# Looks like: GOCSPX-...
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
#  Google Sheet: run log  (REQUIRED)
# -----------------------------------------------------------------------------
#  Every run adds a row here (started → completed / failed / insufficient_sources).
#  The sheet needs a tab named "runs" whose row 1 holds these 13 headers,
#  one per column (A1 = run_id ... M1 = error_message):
#    run_id timestamp email topic depth style num_sources_requested
#    sources_used confidence verdict status duration_sec error_message

# The Sheet ID or the whole sheet URL; both work.
# The ID is the part of the URL between /d/ and /edit:
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=


# -----------------------------------------------------------------------------
#  Optional
# -----------------------------------------------------------------------------

# Timezone n8n uses for timestamps and schedules (IANA name).
# Examples: UTC, Africa/Addis_Ababa, Europe/London, America/New_York
# After changing it, restart n8n with: docker compose up -d
TIMEZONE=UTC

# Public address of n8n, used to build form and webhook URLs.
# Keep the default when running on your own computer. Change it only if you
# expose n8n through a domain or tunnel (keep the trailing slash).
N8N_PUBLIC_URL=http://localhost:5678/

# Tavily search API key. Not needed: web search uses the self-hosted SearXNG
# by default. Fill this in only if you switch CONFIG.search.provider to
# 'tavily' in the "02 Validate" node. Leave empty to create a placeholder.
# Where: https://app.tavily.com   Looks like: tvly-...
TAVILY_API_KEY=
