# ResearchFlow AI: environment template
# Copy to .env and fill in real values. Never commit .env.
# On n8n Cloud, store these as n8n Credentials instead; this file is a reference.

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Fast model: planning, scoring, analysis, short emails
CLAUDE_MODEL_FAST=claude-haiku-5-5
# Strong model: report writing, fact-checking, revision, HTML
CLAUDE_MODEL_STRONG=claude-sonnet-5-5

# --- Tavily (search + extract) ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS_PER_QUERY=5

# --- Google Sheets (run log) ---
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_TAB=runs

# --- Gmail ---
GMAIL_SENDER_NAME=AI Research Pipeline
GMAIL_SENDER_ADDRESS=you@example.com

# --- PDF rendering ---
# Gotenberg (self-hosted or hosted) endpoint, or another HTML-to-PDF API
PDF_SERVICE_URL=https://your-gotenberg-host/forms/chromium/convert/html
PDF_API_KEY=

# --- Pipeline limits ---
MAX_SOURCES=10
MIN_SOURCES_REQUIRED=2
SCORER_EXCERPT_CHARS=1500
