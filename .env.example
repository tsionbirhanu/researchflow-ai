# ResearchFlow AI: environment reference
# Copy to .env and fill in real values. Never commit .env.
# n8n Cloud can't read custom environment variables: store keys as n8n Credentials
# and put the non-secret settings in CONFIG in the "02 Validate" Code node.

# --- Claude API (n8n credential: Header Auth, name x-api-key) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_VERSION=2026-10-21
# Fast model: planning, scoring, analysis, short emails
CLAUDE_MODEL_FAST=claude-haiku-5-5
# Strong model: report writing, fact-checking, revision
CLAUDE_MODEL_STRONG=claude-sonnet-5-5

# --- Tavily (n8n credential: Header Auth, name Authorization, value "Bearer <key>") ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# --- n8n API, used by the error handler (Header Auth, name X-N8N-API-KEY) ---
N8N_API_KEY=

# --- Google Sheets (run log) ---
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_TAB=runs

# --- PDF rendering (Gotenberg Chromium HTML route) ---
PDF_SERVICE_URL=https://your-gotenberg-host/forms/chromium/convert/html

# --- Pipeline limits (mirrors CONFIG in 02 Validate) ---
MAX_SOURCES=10
MIN_SOURCES_REQUIRED=2
CANDIDATES_TO_SCORE=15
RESULTS_PER_QUERY=5
SCORER_EXCERPT_CHARS=1500
ANALYZER_CONTENT_CHARS=12000
