# ResearchFlow AI: settings for `npm run setup` and docker compose.
# Copy to .env and fill in real values. .env is git-ignored: never commit it.
# `npm run setup` reads this file and creates the n8n credentials and workflows for you.

# --- n8n (docker-compose.yml) ---
N8N_URL=http://localhost:5678
# n8n → Settings → n8n API → Create an API key
N8N_API_KEY=

# --- Gemini, free: aistudio.google.com → Get API key ---
GEMINI_API_KEY=

# --- Google OAuth client: Google Cloud Console → Google Auth Platform → Clients ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Sheet for the run log: the ID or the whole sheet URL (tab must be named "runs") ---
GOOGLE_SHEET_ID=

# --- Optional ---
# Timezone for n8n timestamps, e.g. Africa/Addis_Ababa (then: docker compose up -d)
TIMEZONE=UTC
N8N_PUBLIC_URL=http://localhost:5678/
# Tavily is optional; search uses SearXNG by default
TAVILY_API_KEY=
