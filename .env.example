# ResearchFlow AI: environment reference
# Copy to .env and fill in real values. Never commit .env.
# API keys go into n8n Credentials (Settings in the n8n UI), not into workflows.
# Non-secret settings live in CONFIG in the "02 Validate" Code node.

# --- docker-compose.yml (read automatically from .env) ---
TIMEZONE=UTC
N8N_PUBLIC_URL=http://localhost:5678/

# --- LLM: Google Gemini, free via AI Studio (no credit card) ---
# n8n credential "LLM API": Header Auth, Name = Authorization, Value = Bearer <key>
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxx
LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL_FAST=gemini-flash-lite-latest
LLM_MODEL_STRONG=gemini-flash-latest

# Optional paid alternative: Claude (credential: Header Auth, Name = x-api-key)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- Tavily, free 1,000 credits/month (credential: Authorization = Bearer <key>) ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# --- n8n API, used by the error handler (credential: X-N8N-API-KEY) ---
N8N_API_KEY=

# --- Google Sheets (run log) ---
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_TAB=runs

# --- PDF: Gotenberg from docker-compose.yml ---
PDF_SERVICE_URL=http://gotenberg:3000/forms/chromium/convert/html

# --- Pipeline limits (mirrors CONFIG in 02 Validate) ---
MAX_SOURCES=10
MIN_SOURCES_REQUIRED=2
CANDIDATES_TO_SCORE=10
SCORE_BATCH_SIZE=5
RESULTS_PER_QUERY=5
SCORER_EXCERPT_CHARS=1500
ANALYZER_CONTENT_CHARS=12000
